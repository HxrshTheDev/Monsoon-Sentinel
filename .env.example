# CityPulse / Monsoon Sentinel — environment template
# Copy to .env and adjust. Do not commit real secrets.

ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
ENABLE_DEMO_SEED=true

# API bind
HOST=0.0.0.0
PORT=8000

# Optional path overrides (defaults are Mumbai-only)
DATA_DIR=./data
GRID_GEOJSON_PATH=./data/processed/grids/mumbai_grid_500m.geojson
STATIC_FEATURES_PATH=./data/processed/features/mumbai_static_spatial_features.parquet
CRITICAL_INFRA_PATH=./data/processed/vectors/mumbai_critical_infrastructure.parquet
MODEL_PATH=./models/trained/mumbai_xgboost_baseline.json

# Frontend (Angular environment.ts)
# apiBaseUrl=http://localhost:8000
